# Public app configuration. Only these two values are included in release builds.
QUIP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
QUIP_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Optional developer-only legacy interface. Never enabled in production.
QUIP_LEGACY_FEATURES=false
# Provider and billing credentials belong in Supabase secrets, not this file.
